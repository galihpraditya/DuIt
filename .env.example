# Salin isi file ini ke .env dan isi dengan credentials dari Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Domain produksi aplikasi (dipakai sebagai redirect link verifikasi email di build Android/Capacitor)
VITE_APP_URL=https://duit-wallet.vercel.app
